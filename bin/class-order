#!/usr/bin/env php
<?php

declare(strict_types=1);

use Drago\ClassOrder\ClassMemberOrderer;

$useColors = function_exists('stream_isatty')
	&& stream_isatty(STDOUT)
	&& getenv('NO_COLOR') === false
	&& getenv('TERM') !== 'dumb';
$colorize = static function (string $text, string $color) use ($useColors): string {
	return $useColors ? "\033[{$color}m{$text}\033[0m" : $text;
};

$autoloadPaths = isset($_composer_autoload_path) && is_string($_composer_autoload_path)
	? [$_composer_autoload_path]
	: [];
$autoloadPaths = [
	...$autoloadPaths,
	getcwd() . '/vendor/autoload.php',
	__DIR__ . '/../vendor/autoload.php',
];

foreach ($autoloadPaths as $autoloadPath) {
	if (is_file($autoloadPath)) {
		require $autoloadPath;
		break;
	}
}

if (!class_exists(ClassMemberOrderer::class)) {
	fwrite(STDERR, $colorize('ERROR', '31') . ": Composer autoload.php not found. Run 'composer install' first.\n");
	exit(2);
}

$fix = false;
$paths = [];

$arguments = array_slice($argv, 1);
for ($index = 0; $index < count($arguments); $index++) {
	$argument = $arguments[$index];
	if ($argument === '--help' || $argument === '-h') {
		echo "Usage: class-order [-d path] [-f|--fix] [path ...]\n";
		echo "Checks class member ordering by default; --fix writes safe reorderings.\n";
		exit(0);
	}

	if ($argument === '--fix') {
		$fix = true;
		continue;
	}

	if ($argument === '-f') {
		$fix = true;
		continue;
	}

	if ($argument === '-d') {
		$path = $arguments[++$index] ?? null;
		if ($path === null) {
			fwrite(STDERR, "ERROR: -d requires a directory or file path.\n");
			exit(2);
		}
		$paths[] = $path;
		continue;
	}

	if (str_starts_with($argument, '-')) {
		fwrite(STDERR, $colorize('ERROR', '31') . ": Unknown option: {$argument}\n");
		exit(2);
	}

	$paths[] = $argument;
}

$paths = $paths !== [] ? $paths : ['.'];
$mode = $fix ? 'Fix' : 'Check';
fwrite(STDOUT, 'Mode: ' . $colorize($mode, '36') . "\n");
fwrite(STDOUT, 'Paths: ' . implode(', ', $paths) . "\n");

$files = [];
$errors = 0;
foreach ($paths as $path) {
	fwrite(STDOUT, "Scanning {$path}\n");
	if (is_file($path)) {
		if (strtolower(pathinfo($path, PATHINFO_EXTENSION)) === 'php') {
			$files[] = $path;
		}
		continue;
	}

	if (!is_dir($path)) {
		fwrite(STDERR, $colorize('ERROR', '31') . ": Path not found: {$path}\n");
		$errors++;
		continue;
	}

	$iterator = new RecursiveIteratorIterator(
		new RecursiveCallbackFilterIterator(
			new RecursiveDirectoryIterator($path, FilesystemIterator::SKIP_DOTS),
			static fn(SplFileInfo $file): bool => !$file->isDir() || !in_array($file->getFilename(), ['.git', 'vendor', 'node_modules', 'temp', 'cache'], true),
		),
	);

	foreach ($iterator as $file) {
		if ($file->isFile() && strtolower($file->getExtension()) === 'php') {
			$files[] = $file->getPathname();
		}
	}
}

$files = array_values(array_unique($files));
fwrite(STDOUT, 'Found ' . count($files) . " PHP files.\n");
$needsFix = 0;
$fixed = 0;
foreach ($files as $file) {
	try {
		$source = file_get_contents($file);
		if ($source === false) {
			throw new RuntimeException('Unable to read file.');
		}

		$ordered = (new ClassMemberOrderer())->reorder($source);
		if ($ordered === null) {
			continue;
		}

		if (!$fix) {
			fwrite(STDOUT, $colorize('NEEDS FIX', '33') . ": {$file}\n");
			$needsFix++;
			continue;
		}

		if (file_put_contents($file, $ordered) === false) {
			throw new RuntimeException('Unable to write file.');
		}

		fwrite(STDOUT, $colorize('FIXED', '32') . ": {$file}\n");
		$fixed++;
	} catch (Throwable $exception) {
		fwrite(STDERR, $colorize('ERROR', '31') . ": {$file}: {$exception->getMessage()}\n");
		$errors++;
	}
}

if ($errors > 0) {
	fwrite(STDOUT, $colorize("Done with {$errors} error(s).", '31') . "\n");
	exit(2);
}

if ($fix) {
	fwrite(STDOUT, $fixed > 0
		? $colorize('Done. Fixed ' . $fixed . ' of ' . count($files) . ' PHP files.', '32') . "\n"
		: $colorize('Done. No changes needed.', '32') . "\n");
	exit(0);
}

if ($needsFix > 0) {
	fwrite(STDOUT, $colorize("Done. {$needsFix} PHP files need reordering.", '33') . "\n");
	exit(1);
}

fwrite(STDOUT, $colorize('Done. No ordering issues found in ' . count($files) . ' PHP files.', '32') . "\n");
exit(0);
