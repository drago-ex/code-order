#!/usr/bin/env php
<?php

declare(strict_types=1);

use Drago\ClassOrder\ClassMemberOrderer;
use Drago\CodeOrder\Command;

// The Composer bin proxy sets $_composer_autoload_path; otherwise try the project, then this package.
// An autoloader without this package (e.g. the vendor of the scanned project) is skipped.
foreach ([$_composer_autoload_path ?? null, getcwd() . '/vendor/autoload.php', __DIR__ . '/../vendor/autoload.php'] as $autoload) {
	if (is_string($autoload) && is_file($autoload)) {
		require_once $autoload;
		if (class_exists(Command::class)) {
			break;
		}
	}
}

if (!class_exists(Command::class)) {
	fwrite(STDERR, "ERROR: Composer autoload.php not found. Run 'composer install' first.\n");
	exit(2);
}

$command = new Command(
	name: 'class-order',
	description: 'Checks class member ordering by default; --fix applies configured reorderings.',
	acceptsConfig: false,
	createReorder: static fn(?string $config): Closure => (new ClassMemberOrderer)->reorder(...),
);

exit($command->run(array_slice($argv, 1)));
